import os

DATA_FOLDER_ID, = glob_wildcards("data/publication_meddat_data/abfrage_{id}.csv")

configfile: "config.yml"
MINIMUM_LIFETIME = 0.5
MAX_QUARTER = 32
DISCRIMINATION_POINT = 365
DATASET_DIR = "data/publication_output/dataset"

# final step, used for model training and evaluation
rule classify:
    input:
        DATASET_DIR + "/survival_feature_matrix.csv",
    output:
        DATASET_DIR + "/models/gbm_all_patients.joblib"
    params:
        plot_dir=DATASET_DIR + "/plots",
        max_quarter = MAX_QUARTER,
        model_params = {"n_estimators": 1500, "learning_rate": 0.01, "max_depth": 3, "features_per_split": 80, "random_state": 123, "sample_weight": 2.3}
    threads: 8
    script:
        "scripts_no_filter/model_training_only.py"

rule classify_with_easix:
    input:
        DATASET_DIR + "/survival_feature_matrix.csv",
        DATASET_DIR + "/kaplan_meier_input_easix.csv"
    output:
        DATASET_DIR + "/models/gbm_all_patients_easix_baseline.joblib",
    params:
        model_params = {"n_estimators": 500, "learning_rate": 0.01, "max_depth": 3, "features_per_split": 80, "random_state": 123, "sample_weight": 2.3}
    threads: 8
    script:
        "scripts_no_filter/model_training_only_with_easix.py"

rule all:
    input:
        DATASET_DIR + "/models/gbm_all_patients.joblib",
        DATASET_DIR + "/models/gbm_all_patients_easix_baseline.joblib",


