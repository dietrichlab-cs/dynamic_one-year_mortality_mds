import os

DATA_FOLDER_ID, = glob_wildcards("data/publication_meddat_data/abfrage_{id}.csv")

def get_time_series_files(wildcards):
    ts_output = checkpoints.build_patient_time_series.get(**wildcards).output[0]
    ser, = glob_wildcards(os.path.join(ts_output, "{patient}.csv"))
    return expand(os.path.join(ts_output[:-9], "features", "{patient}_feature_matrix.csv").replace("\\", "/"), patient=ser)

def get_label_files(wildcards):
    ts_output = checkpoints.build_patient_time_series.get(**wildcards).output[0]
    ser, = glob_wildcards(os.path.join(ts_output, "{patient}.csv"))
    return expand(os.path.join(ts_output[:-9], "labels", "{patient}_labels.csv").replace("\\", "/"), patient=ser)


MINIMUM_LIFETIME = 0.5
MAX_QUARTER = 32
DISCRIMINATION_POINT = 365
DATASET_DIR = "data/publication_output/dataset_aml"

# this step filters patients based on missing meta information and patients with stem-cell-transplantation
rule create_patient_set:
    input:
        "data/publication_ipssr/mds_paper.csv",
        "data/publication_ipssr/error_ids.csv"
    output:
        DATASET_DIR + "/patient_data_filtered.csv",
        DATASET_DIR + "/ids_filtered.csv"
    params:
        minimum_lifetime=MINIMUM_LIFETIME
    script:
        "scripts_no_filter_aml/filter_patients.py"

# this step extracts the chosen parameters parameters from the MEDICO outputs
checkpoint build_patient_time_series:
    input:
        DATASET_DIR + "/patient_data_filtered.csv",
        expand("data/publication_meddat_data/abfrage_{data_folder_id}.csv", data_folder_id = DATA_FOLDER_ID)
    params:
        parameters= {"HB304": "Hämoglobin","HK305": "Hämatokrit","ERY303": "Erythrozyten","THROMB310": "Thrombozyten","LEUKO302": "Leukozyten"},
        alias_parameter = ["KAM-LEU400_LEUKO302", "KAM-THR399_THROMB310"],
        output_directory = DATASET_DIR,
        minimum_entries= 3
    output:
        directory(DATASET_DIR + "/raw_data/")
    script:
        "scripts_no_filter_aml/extract_ts_patient_data.py"


# some meta information on the patient is extracted in this step. Like the available data-span and if the event of interest occurred
rule data_analysis:
    input:
        DATASET_DIR + "/patient_data_filtered.csv",
        DATASET_DIR + "/raw_data/{patient}.csv"
    params:
        dataset_name = DATASET_DIR,
    output:
        DATASET_DIR + "/labels/{patient}_labels.csv"
    script:
        "scripts_no_filter_aml/data_analysis.py"



# this step sub-samples the time-series and extracts the chosen time-series features
rule build_time_series_feature_matrix:
    input:
        DATASET_DIR + "/labels/{patient}_labels.csv",
        DATASET_DIR + "/raw_data/{patient}.csv"
    output:
        DATASET_DIR + "/features/{patient}_feature_matrix.csv"
    params:
        discrimination_point=DISCRIMINATION_POINT,
        min_nb_samples=3,
        max_quarter=MAX_QUARTER,
    threads: 1
    script:
        "scripts_no_filter_aml/build_time_series_feature_matrix.py"



# this step combines the time-series feature outputs with the set of chosen constant admission based parameters
rule build_complete_feature_matrix:
    input:
        DATASET_DIR + "/patient_data_filtered.csv",
        get_time_series_files
    output:
        DATASET_DIR + "/survival_feature_matrix.csv",
        DATASET_DIR + "/survival_constant_only_feature_matrix.csv",
    params:
        subsamples = MAX_QUARTER,
        dataset_dir = DATASET_DIR
    threads: 4
    script:
        "scripts_no_filter_aml/build_complete_feature_matrix.py"



# final step, used for model training and evaluation
rule classify:
    input:
        DATASET_DIR + "/survival_feature_matrix.csv",
        DATASET_DIR + "/survival_constant_only_feature_matrix.csv",
    output:
        DATASET_DIR + "/classification.csv",
        DATASET_DIR + "/feature_importance.csv"
    params:
        plot_dir=DATASET_DIR + "/plots",
        max_quarter = MAX_QUARTER,
        model_params = {"n_estimators": 1500, "learning_rate": 0.01, "max_depth": 3, "features_per_split": 80, "random_state": 123, "sample_weight": 2.3},
        baseline_model_params = {"n_estimators": 500, "learning_rate": 0.01, "max_depth": 3, "features_per_split": 80, "random_state": 123, "sample_weight": 2.3}
    threads: 8
    script:
        "scripts_no_filter_aml/cross_validation.py"


rule all:
    input:
        DATASET_DIR + "/classification.csv",
        DATASET_DIR + "/feature_importance.csv"


