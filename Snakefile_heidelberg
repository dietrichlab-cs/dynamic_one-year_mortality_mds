configfile: "config.yml"
MINIMUM_LIFETIME = 0.5
MAX_QUARTER = 32
DISCRIMINATION_POINT = 365
DATASET_DIR = "data/publication_output/d_heidelberg"

# this step filters patients based on missing meta information and patients with stem-cell-transplantation
rule create_patient_set:
    input:
        "data/validation_heidelberg/heidelberg_admission.csv",
    output:
        DATASET_DIR + "/patient_data_filtered.csv",
        DATASET_DIR + "/ids_filtered.csv"
    params:
        minimum_lifetime=MINIMUM_LIFETIME
    script:
        "scripts_heidelberg/filter_patients.py"

# this step extracts the chosen parameters parameters from the CIS outputs
checkpoint build_patient_time_series:
    input:
        DATASET_DIR + "/patient_data_filtered.csv",
        ["data/validation_heidelberg/lab_heidelberg.csv"]
    params:
        parameters = {"HB": "Hämoglobin","HKT": "Hämatokrit","ERY": "Erythrozyten","THROMBO": "Thrombozyten","LEUKO": "Leukozyten"},
        alias_parameter = [],
        output_directory = DATASET_DIR,
        minimum_entries= 3
    output:
        directory(DATASET_DIR + "/raw_data/")
    script:
        "scripts_heidelberg/extract_ts_patient_data.py"


# some meta information on the patient is extracted in this step. Like the available data-span and if the event of interest occurred
rule data_analysis:
    input:
        DATASET_DIR + "/patient_data_filtered.csv",
        DATASET_DIR + "/raw_data/{patient}.csv"
    params:
        dataset_name = DATASET_DIR,
    output:
        DATASET_DIR + "/labels/{patient}_labels.csv"
    script:
        "scripts_heidelberg/data_analysis.py"



# this step sub-samples the time-series and extracts the chosen time-series features
rule build_time_series_feature_matrix:
    input:
        DATASET_DIR + "/labels/{patient}_labels.csv",
        DATASET_DIR + "/raw_data/{patient}.csv"
    output:
        DATASET_DIR + "/features/{patient}_feature_matrix.csv"
    params:
        discrimination_point=DISCRIMINATION_POINT,
        min_nb_samples=3,
        max_quarter=MAX_QUARTER,
    script:
        "scripts_heidelberg/build_time_series_feature_matrix.py"



# this step combines the time-series feature outputs with the set of chosen constant admission based parameters
rule build_complete_feature_matrix:
    input:
        DATASET_DIR + "/patient_data_filtered.csv",
        get_time_series_files
    output:
        DATASET_DIR + "/survival_feature_matrix.csv",
        DATASET_DIR + "/survival_feature_matrix_constant.csv"
    params:
        subsamples = MAX_QUARTER,
        dataset_dir = DATASET_DIR
    threads: 4
    script:
        "scripts_heidelberg/build_complete_feature_matrix.py"



# final step, used for model training and evaluation
rule classify:
    input:
        "data/publication_output/dataset/models/gbm_all_patients.joblib",
        "data/publication_output/dataset/models/gbm_all_patients_easix_baseline.joblib",
        DATASET_DIR + "/survival_feature_matrix.csv",
    output:
        DATASET_DIR + "/metrics_full_model.txt"
        # DATASET_DIR + "/feature_importance.csv"
    params:
        plot_dir=DATASET_DIR + "/plots",
        max_quarter = MAX_QUARTER
    threads: 8
    script:
        "scripts_heidelberg/classification.py"

rule all:
    input:
        DATASET_DIR + "/metrics_full_model.txt",
        # DATASET_DIR + "/feature_importance.csv"


